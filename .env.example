# Required. Postgres connection string. Neon, or any Postgres.
DATABASE_URL=

# Required. 32-byte hex key. Encrypts sensitive fields and signs session cookies.
APP_ENCRYPTION_KEY=

# Required. Any secret string. Creating an account demands it.
SIGNUP_INVITE_CODE=

# Optional. Idle minutes before a session locks. Default 15.
# AUTH_IDLE_MINUTES=15

# Optional. Enables the AI category review, capped at 2 runs per card per month.
# Without it the app makes no outbound request at all. Extraction never uses AI.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Optional. Absolute URL of the deployment, used for canonical metadata.
# NEXT_PUBLIC_SITE_URL=https://outlay.example.com
